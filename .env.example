# MarketPulse AI Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' to version control.

# --- OpenAI API Key ---
OPENAI_API_KEY="sk-proj-YOUR-OPENAI-API-KEY-HERE"

# --- Database Connection ---
DATABASE_URL="postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/marketpulse"
TEST_DATABASE_URL="postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/marketpulse_test"

# --- Application Logging & Debugging ---
LOG_LEVEL="INFO"
ENVIRONMENT="development"
