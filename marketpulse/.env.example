# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/marketpulse

# ── Redis Cloud ────────────────────────────────────────
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@your-redis-host.redis.io:PORT

# ── LLM Keys ──────────────────────────────────────────
NVIDIA_API_KEY=nvapi-...
OPENROUTER_API_KEY=sk-or-v1-...

# ── API Security ───────────────────────────────────────
API_KEY=your-secret-api-key

# ── Ingestion Config ───────────────────────────────────
POLL_INTERVAL_MINUTES=15
PRICE_CHANGE_ALERT_THRESHOLD=0.02

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
